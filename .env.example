# ---------------------------------------------------------------------------
# Xerex AI — environment template
# Copy to `.env` and adjust. All internal identifiers stay English.
#
# Production checklist (the API refuses to start until these are satisfied):
#   * XEREX_SECRET_KEY        — explicit, random, at least 32 characters
#   * XEREX_CREDENTIALS_ENCRYPTION_KEY — 32 bytes of url-safe base64 or 64 hex chars
#   * XEREX_BOOTSTRAP_ENABLED — leave `false` except for the very first boot
#   * POSTGRES_PASSWORD / REDIS_PASSWORD — used by docker-compose.yml
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
XEREX_ENVIRONMENT=development          # development | test | staging | production
XEREX_DEBUG=true                       # must be false in production
XEREX_APP_NAME=Xerex AI
XEREX_API_V1_PREFIX=/api/v1
XEREX_LOG_LEVEL=INFO
XEREX_LOG_JSON=false                   # true in production (structured logs)
XEREX_SERVER_HOST=0.0.0.0
XEREX_SERVER_PORT=8000

# --- Security --------------------------------------------------------------
# Required in staging/production. The value below is intentionally a placeholder:
# startup validation rejects placeholders, short values and low-entropy strings.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
XEREX_SECRET_KEY=change-me-in-production
# Dedicated key used to encrypt provider credentials (AES-256-GCM). Required in
# staging/production; development and test may leave it empty and fall back to a
# key derived from XEREX_SECRET_KEY.
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
XEREX_CREDENTIALS_ENCRYPTION_KEY=
XEREX_ACCESS_TOKEN_TTL_MINUTES=15
XEREX_REFRESH_TOKEN_TTL_DAYS=14
# First-run owner creation. Leave empty (or false) in production: an empty value
# means "environment default" — enabled in development/test, disabled elsewhere.
# Set to true only for the first boot of a new deployment, then set it back to false.
XEREX_BOOTSTRAP_ENABLED=
XEREX_PASSWORD_MIN_LENGTH=10
XEREX_LOGIN_RATE_LIMIT_ATTEMPTS=10
XEREX_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Reverse proxies whose X-Forwarded-For header may be trusted. Empty means "trust
# nothing": a direct client cannot spoof its address. Comma separated IPs/CIDRs.
# The application (not uvicorn) makes this decision — the API is always started with
# --no-proxy-headers, so the peer address it validates against is the real TCP peer.
# Examples: the nginx container of docker-compose.yml → 172.28.0.10
#           a cloud load balancer → 10.0.0.0/8
XEREX_TRUSTED_PROXIES=
XEREX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database --------------------------------------------------------------
XEREX_DATABASE_URL=postgresql+asyncpg://xerex:xerex@localhost:5432/xerex
XEREX_DATABASE_ECHO=false
XEREX_DATABASE_POOL_SIZE=10
XEREX_DATABASE_MAX_OVERFLOW=20

# --- Redis -----------------------------------------------------------------
XEREX_REDIS_URL=redis://localhost:6379/0
# Credentials are injected into the URL by the application; never hard-code them.
# Either embed them in XEREX_REDIS_URL or use these two variables.
XEREX_REDIS_USERNAME=
XEREX_REDIS_PASSWORD=
XEREX_REDIS_REQUIRED=false             # when false the API degrades gracefully
XEREX_HEALTH_SCHEDULER_ENABLED=false
XEREX_HEALTH_CHECK_INTERVAL_SECONDS=300
XEREX_RATE_LIMIT_ENABLED=true

# --- Localization ----------------------------------------------------------
XEREX_DEFAULT_LOCALE=fa                # Persian-first admin panel
XEREX_SUPPORTED_LOCALES=["fa","en"]
XEREX_DEFAULT_TIMEZONE=Asia/Tehran

# --- Docker Compose secrets ------------------------------------------------
# Consumed by docker-compose.yml (not by the API process itself).
POSTGRES_USER=xerex
POSTGRES_PASSWORD=
POSTGRES_DB=xerex
REDIS_PASSWORD=

# --- Frontend (build-time, Vite) -------------------------------------------
# VITE_API_BASE_URL=/api/v1
